

package bingo;

import java.util.Random;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        String[][] carton = new String[5][5];
        Random random = new Random();
        Scanner sc = new Scanner(System.in);

        for( int fila = 0; fila < 5; fila++) {
            for( int columna = 0; columna < 5; columna ++){
                boolean repetido;
                int numAleatorio;

                do{
                    repetido = false;
                    numAleatorio = random.nextInt(25) + 1;
                    String numString = String.valueOf(numAleatorio);

                    for (int f = 0; f< 5; f++){
                        for (int c  = 0; c <5; c++){
                            if(carton[f][c] != null && carton[f][c].equals(numString)){
                                repetido = true;
                                break;
                            }
                        }
                        if(repetido) break;
                    }
                } while(repetido);

                carton[fila][columna] = String.valueOf(numAleatorio);
            }
        }

        System.out.println("Cartón de Bingo:");
        for(int fila = 0; fila < 5; fila++){
            for(int columna = 0; columna < 5; columna++){
                System.out.print(carton[fila][columna] + "\t");
            }
            System.out.println();
        }

        int filaEliminar = -1;
        int columnaEliminar = -1;
        boolean entradaValida = false;

        while(!entradaValida){
            System.out.print("Ingrese la fila (0-4) del número a eliminar: ");
            filaEliminar = sc.nextInt();
            System.out.print("Ingrese la columna (0-4) del número a eliminar: ");
            columnaEliminar = sc.nextInt();

            if(filaEliminar >= 0 && filaEliminar < 5 && columnaEliminar >= 0 && columnaEliminar < 5){
                entradaValida = true;
            } else {
                System.out.println("Entrada inválida. Por favor, ingrese valores entre 0 y 4.");}
                
        carton[filaEliminar][columnaEliminar] = "X";

        System.out.println("Cartón de Bingo actualizado:");
        for(int fila = 0; fila < 5; fila++){
            for(int columna = 0; columna < 5; columna++){
                System.out.print(carton[fila][columna] + "\t");
            }
            System.out.println();
        }



    }
}
}
